### HOSTINGER LITESHIELD RECAPTCHA, DO NOT REMOVE THIS LINE ###
RewriteEngine On
LsRecaptcha 100
RewriteRule .* - [E=verifycaptcha:drop]
### HOSTINGER LITESHIELD RECAPTCHA, DO NOT REMOVE THIS LINE ###
RewriteEngine On

# EMERGENCY DDoS PROTECTION - Enhanced
# Block suspicious user agents and known bots
RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
RewriteCond %{HTTP_USER_AGENT} ^-?$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider|scraper|wget|curl|python|scrapy|java|perl|ruby|go-http) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} (bingbot|googlebot|facebookexternalhit|meta-externalagent|slurp|msnbot|teoma|yandex) [NC,OR]
RewriteCond %{HTTP_USER_AGENT} (aiohttp|python-requests|httpclient|okhttp|libwww|lwp|mechanize) [NC]
RewriteRule ^api/ - [F,L]

# Block specific malicious IPs from your logs
RewriteCond %{REMOTE_ADDR} ^(191\.96\.168\.95|157\.55\.39\.) [NC]
RewriteRule ^api/ - [F,L]

# Block malformed nested URL patterns
RewriteCond %{REQUEST_URI} (blog/.*/blog/.*/gallery/.*/blog/.*) [NC,OR]
RewriteCond %{REQUEST_URI} (sitemap-html/.*/assets/.*/assets/.*) [NC]
RewriteRule .* - [F,L]

# Block requests without proper headers for API
RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{HTTP:Accept} ^$ [OR]
RewriteCond %{HTTP_USER_AGENT} ^$
RewriteRule ^ - [F,L]

# Limit POST requests to mail.php
RewriteCond %{REQUEST_METHOD} POST
RewriteCond %{REQUEST_URI} ^/api/mail\.php$
RewriteCond %{REMOTE_ADDR} ^(.*)
RewriteRule .* - [E=API_REQUEST:1]

# Handle tour detail pages
RewriteRule ^tour/([a-zA-Z0-9-]+)$ index.php?type=tour&slug=$1 [L,QSA]

# Handle blog detail pages
RewriteRule ^blog/([a-zA-Z0-9-]+)$ index.php?type=blog&slug=$1 [L,QSA]

# Handle other pages (if needed)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]

# Protect sensitive files
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

<Files "*.json">
    Order allow,deny
    Deny from all
</Files>

# Prevent directory listing
Options -Indexes